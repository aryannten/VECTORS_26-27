# VECTORS 2026 — Server Environment Variables Example
# Copy this file to .env and configure with your actual secrets

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/vectors2026?retryWrites=true&w=majority

# Server Port
PORT=5000

# Environment Mode: development | production
NODE_ENV=development

# Allowed CORS Origins (comma separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://yourproductiondomain.com

# Initial Super Admin Email (auto-seeded to admin role on server startup)
ADMIN_EMAIL=admin@vectors2026.com

# Path to Firebase Service Account Key JSON (optional, defaults to ./serviceAccountKey.json)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
